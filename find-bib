#!/usr/bin/env python3
from __future__ import annotations

import re
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any

SCRIPT_DIR = Path(__file__).resolve().parent
HELP_TEXT_DIR = SCRIPT_DIR / "help-text"

FILTER_FLAGS = {
    "--author": "author",
    "--year": "year",
    "--doi": "doi",
    "--title": "title",
    "--abstract": "abstract",
}


class UsageError(ValueError):
    pass


def _print_help(name: str) -> int:
    path = HELP_TEXT_DIR / name
    try:
        sys.stdout.write(path.read_text(encoding="utf-8"))
    except OSError as exc:
        print(f"find-bib: cannot read help text: {exc}", file=sys.stderr)
        return 2
    return 0


def _handle_help(argv: list[str]) -> int | None:
    human_requested = "--human" in argv
    help_requested = any(arg in {"-h", "--help"} for arg in argv)

    if human_requested:
        for arg in argv:
            if arg not in {"--human", "-h", "--help"}:
                print(f"find-bib: --human cannot be combined with {arg}", file=sys.stderr)
                return 2
        return _print_help("find-bib-human.txt")

    if help_requested:
        return _print_help("find-bib-help.txt")

    return None


def _bootstrap_agent_tools() -> None:
    candidates = [
        SCRIPT_DIR / "python" / "src",
        SCRIPT_DIR / ".agent-tools-python",
    ]
    existing = [str(path) for path in candidates if (path / "agent_tools").is_dir()]
    for path in reversed(existing):
        if path not in sys.path:
            sys.path.insert(0, path)


def _normalize(value: Any) -> str:
    text = str(value or "").replace("{", "").replace("}", "").casefold()
    return re.sub(r"\s+", " ", text).strip()


def _name_text(value: Any) -> str:
    if isinstance(value, dict):
        parts = [str(value.get("family") or "").strip(), str(value.get("given") or "").strip()]
        return ", ".join(part for part in parts if part)
    return str(value or "")


def _authors_text(entry: dict[str, Any]) -> str:
    authors = entry.get("author")
    if isinstance(authors, list):
        return "; ".join(_name_text(author) for author in authors if _name_text(author))
    if authors is not None:
        return str(authors)
    return str(entry.get("authors") or "")


def _year_text(entry: dict[str, Any]) -> str:
    issued = entry.get("issued")
    if isinstance(issued, dict):
        parts = issued.get("date-parts")
        if isinstance(parts, list) and parts and isinstance(parts[0], list) and parts[0]:
            return str(parts[0][0])
        literal = issued.get("literal")
        if literal is not None:
            match = re.search(r"(?:19|20)\d{2}", str(literal))
            if match:
                return match.group(0)
    if issued is not None:
        match = re.search(r"(?:19|20)\d{2}", str(issued))
        if match:
            return match.group(0)
    return ""


def _match_any(haystack: Any, needles: list[str]) -> bool:
    if not needles:
        return True
    normalized = _normalize(haystack)
    return any(_normalize(needle) in normalized for needle in needles)


def _matches(entry: dict[str, Any], filters: dict[str, list[str]]) -> bool:
    return (
        _match_any(_authors_text(entry), filters["author"])
        and _match_any(_year_text(entry), filters["year"])
        and _match_any(entry.get("DOI") or entry.get("doi") or "", filters["doi"])
        and _match_any(entry.get("title") or "", filters["title"])
        and _match_any(entry.get("abstract") or "", filters["abstract"])
    )


def _parse_args(argv: list[str]) -> tuple[dict[str, list[str]], bool]:
    filters = {name: [] for name in FILTER_FLAGS.values()}
    cat_mode = False
    index = 0
    while index < len(argv):
        arg = argv[index]
        if arg in FILTER_FLAGS:
            if index + 1 >= len(argv) or argv[index + 1].startswith("--"):
                raise UsageError(f"{arg} requires a value")
            filters[FILTER_FLAGS[arg]].append(argv[index + 1])
            index += 2
            continue
        if arg == "--cat":
            cat_mode = True
            index += 1
            continue
        if arg.startswith("-"):
            raise UsageError(f"unknown flag: {arg}")
        raise UsageError(f"unexpected positional argument: {arg}")
    return filters, cat_mode


def _catalog_entries() -> list[dict[str, Any]]:
    _bootstrap_agent_tools()
    try:
        from agent_tools import ReferenceCatalog
    except ModuleNotFoundError as exc:
        missing = exc.name or "agent_tools"
        raise UsageError(
            f"canonical agent-tools Python library is unavailable (missing {missing}); "
            "run install.sh or install the python package"
        ) from exc

    catalog = ReferenceCatalog(warn=lambda _message: None)
    try:
        catalog.load()
        count = len(catalog.keys())
        return catalog.search("", limit=count, scope="all")
    except ValueError as exc:
        raise UsageError(str(exc)) from exc


def _key_of(entry: dict[str, Any]) -> str:
    value = entry.get("citation-key") or entry.get("id")
    return str(value or "").strip()


def _emit_cat(entries: list[dict[str, Any]]) -> int:
    cite2bib = shutil.which("cite2bib")
    if cite2bib is None:
        print("find-bib: cite2bib not found for --cat", file=sys.stderr)
        return 2

    emitted = False
    failed = False
    for entry in entries:
        key = _key_of(entry)
        if not key:
            continue
        result = subprocess.run([cite2bib, key], check=False)
        if result.returncode == 0:
            emitted = True
        else:
            failed = True

    if failed:
        return 1
    return 0 if emitted else 1


def main(argv: list[str]) -> int:
    help_result = _handle_help(argv)
    if help_result is not None:
        return help_result

    try:
        filters, cat_mode = _parse_args(argv)
        entries = [entry for entry in _catalog_entries() if _matches(entry, filters)]
    except UsageError as exc:
        print(f"find-bib: {exc}", file=sys.stderr)
        return 2

    if cat_mode:
        return _emit_cat(entries)

    keys = [key for key in (_key_of(entry) for entry in entries) if key]
    if not keys:
        return 1
    sys.stdout.write("\n".join(keys) + "\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
